# NotAnotherWiki Engine, environment reference.
#
# Copy to .env and fill in what you need. Every value here is a placeholder,
# never a real credential. .env is gitignored; keep it that way.
#
# Precedence: environment beats config.toml, config.toml beats the built-in
# defaults. A missing config.toml is not an error: the defaults target the
# local docker compose stack.
#
# This file covers what a self-hosted install needs to boot. It is deliberately
# not the full list of settings the engine understands, and settings that only
# matter for developing the engine itself are not documented here. The
# authority is `Config` in crates/naw-core/src/config.rs.

# ---------------------------------------------------------------------------
#  Core
# ---------------------------------------------------------------------------

# PostgreSQL 18. NAW_DATABASE_URL wins; DATABASE_URL is accepted as a fallback
# so sqlx tooling and the server can share one variable.
NAW_DATABASE_URL=postgres://user:password@127.0.0.1:5432/naw

# Valkey 9, speaking the Redis protocol. NAW_VALKEY_URL wins, VALKEY_URL is
# the fallback.
NAW_VALKEY_URL=redis://127.0.0.1:6379

NAW_HTTP_BIND=127.0.0.1
NAW_HTTP_PORT=4242

# Active skin directory.
NAW_SKIN_DIR=skins/default

# ---------------------------------------------------------------------------
#  Auth
# ---------------------------------------------------------------------------

# Master switch. When false, every auth route answers 404 and nothing else
# about the wiki changes. Reading stays anonymous either way.
NAW_AUTH_ENABLED=false

# Absolute public base URL. Used to build provider callback URLs and email
# links, and it is what decides whether the session cookie gets `Secure`.
# Register exactly {base}/auth/{provider}/callback in each provider console.
# Never derived from the request Host header, on purpose.
NAW_AUTH_BASE_URL=https://wiki.example

# Session lifetime in hours.
NAW_AUTH_SESSION_TTL_HOURS=720

# Attach a new provider identity to an existing account when the provider
# certifies the email address AND that account already confirmed the same
# address. Both sides must be verified: with only one, this would be an
# account takeover.
NAW_AUTH_AUTO_LINK_VERIFIED_EMAIL=true

# A provider is enabled exactly when BOTH its id and secret are present and
# non-empty. There is no separate per-provider switch, and a provider with no
# credentials answers 404 rather than starting a flow it cannot finish.
#
# github.com/settings/developers -> New OAuth App
NAW_GITHUB_CLIENT_ID=
NAW_GITHUB_CLIENT_SECRET=

# discord.com/developers/applications -> OAuth2
NAW_DISCORD_CLIENT_ID=
NAW_DISCORD_CLIENT_SECRET=

# @BotFather -> your bot -> Login Widget. The client id is the bot id and it
# doubles as the id_token `aud` claim. Register the callback in Allowed URLs.
NAW_TELEGRAM_CLIENT_ID=
NAW_TELEGRAM_CLIENT_SECRET=

# ---------------------------------------------------------------------------
#  Mail
# ---------------------------------------------------------------------------

# `log` writes mail to the database and the log, with no SMTP needed.
# `smtp` sends it, and fails loudly rather than dropping mail silently.
NAW_MAIL_BACKEND=log

# smtp://host:port or smtps://user:pass@host:port. Redacted from log output.
NAW_SMTP_URL=
# Envelope from, e.g. "Example WIKI <noreply@wiki.example>".
NAW_MAIL_FROM=

# ---------------------------------------------------------------------------
#  Localisation
# ---------------------------------------------------------------------------

# Interface message catalogues, one TOML file per language.
NAW_LOCALES_DIR=locales

# ---------------------------------------------------------------------------
#  Build time, not runtime
# ---------------------------------------------------------------------------

# Builds against the checked-in .sqlx cache instead of a live database. Set it
# for any build on a machine without PostgreSQL, including CI.
# SQLX_OFFLINE=true
