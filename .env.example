# NotAnotherWiki Engine, environment reference.
#
# Copy to .env and fill in what you need. Every value here is a placeholder,
# never a real credential. .env is gitignored; keep it that way.
#
# Precedence: environment beats config.toml, config.toml beats the built-in
# defaults. A missing config.toml is not an error: the defaults target the
# local docker compose stack.
#
# This file covers what a self-hosted install needs to boot. It is deliberately
# not the full list of settings the engine understands, and settings that only
# matter for developing the engine itself are not documented here. The
# authority is `Config` in crates/naw-core/src/config.rs.

# ---------------------------------------------------------------------------
#  Core
# ---------------------------------------------------------------------------

# PostgreSQL 18. NAW_DATABASE_URL wins; DATABASE_URL is accepted as a fallback
# so sqlx tooling and the server can share one variable.
NAW_DATABASE_URL=postgres://user:password@127.0.0.1:5432/naw

# Valkey 9, speaking the Redis protocol. NAW_VALKEY_URL wins, VALKEY_URL is
# the fallback.
NAW_VALKEY_URL=redis://127.0.0.1:6379

NAW_HTTP_BIND=127.0.0.1
NAW_HTTP_PORT=4242

# Active skin directory.
NAW_SKIN_DIR=skins/default

# Behind a reverse proxy or a tunnel on the same host, every connection comes
# from loopback. Turn this on there, so rate limits and the session log see the
# client address from X-Real-IP or the last X-Forwarded-For hop. Leave it off
# when clients connect directly: those headers are whatever they typed.
NAW_TRUST_PROXY=false

# ---------------------------------------------------------------------------
#  Auth
# ---------------------------------------------------------------------------

# Master switch. When false, every auth route answers 404 and nothing else
# about the wiki changes. Reading stays anonymous either way.
NAW_AUTH_ENABLED=false

# Absolute public base URL. Used to build provider callback URLs and email
# links, and it is what decides whether the session cookie gets `Secure`.
# Register exactly {base}/auth/{provider}/callback in each provider console.
# Never derived from the request Host header, on purpose.
NAW_AUTH_BASE_URL=https://wiki.example

# Session lifetime in hours.
NAW_AUTH_SESSION_TTL_HOURS=720

# Attach a new provider identity to an existing account when the provider
# certifies the email address AND that account already confirmed the same
# address. Both sides must be verified: with only one, this would be an
# account takeover.
NAW_AUTH_AUTO_LINK_VERIFIED_EMAIL=true

# Whether signing in may create an account. `open`: anyone who signs in with
# a provider gets one. `closed`: invite only. Providers still sign in people
# who already have an account; new accounts come from the admin panel or
# `naw user create`, with a temporary password changed on first sign-in.
NAW_AUTH_REGISTRATION=open

# Where the "no account yet" page points when registration is closed, for
# example the page that explains how to ask for one. Optional.
NAW_AUTH_APPLY_URL=

# Username and password sign-in. It is how admin-created accounts and the
# bootstrap owner get in, so it stays on unless every account uses a provider.
NAW_AUTH_PASSWORD_LOGIN=true

# Username changes. The install owner can override each of these in the admin
# panel (Account rules); these are the defaults until they do.
NAW_RENAME_ENABLED=true
NAW_RENAME_COOLDOWN_DAYS=7
# Keep a renamed account's old name reserved for it, so nobody else can take
# it and old links still find the person. 0 days keeps it forever.
NAW_ALIASES_DISABLED=false
NAW_ALIAS_DAYS=30
NAW_MAX_ALIASES=5

# The first owner. On every start the account is created if missing, given the
# root install role and made owner of every wiki. The password is written only
# while the account has none, so a password changed later is never reset by a
# restart. Prefer the _FILE form (a systemd credential or secrets file) over
# putting the password itself in the environment. Leave all three empty to skip.
NAW_BOOTSTRAP_OWNER_USERNAME=
NAW_BOOTSTRAP_OWNER_PASSWORD_FILE=
NAW_BOOTSTRAP_OWNER_PASSWORD=

# A provider is enabled exactly when BOTH its id and secret are present and
# non-empty. There is no separate per-provider switch, and a provider with no
# credentials answers 404 rather than starting a flow it cannot finish.
#
# github.com/settings/developers -> New OAuth App
NAW_GITHUB_CLIENT_ID=
NAW_GITHUB_CLIENT_SECRET=

# discord.com/developers/applications -> OAuth2
NAW_DISCORD_CLIENT_ID=
NAW_DISCORD_CLIENT_SECRET=

# @BotFather -> your bot -> Login Widget. The client id is the bot id and it
# doubles as the id_token `aud` claim. Register the callback in Allowed URLs.
NAW_TELEGRAM_CLIENT_ID=
NAW_TELEGRAM_CLIENT_SECRET=

# ---------------------------------------------------------------------------
#  Mail
# ---------------------------------------------------------------------------

# `log` writes mail to the database and the log, with no SMTP needed.
# `smtp` sends it, and fails loudly rather than dropping mail silently.
NAW_MAIL_BACKEND=log

# smtp://host:port or smtps://user:pass@host:port. Redacted from log output.
NAW_SMTP_URL=
# Envelope from, e.g. "Example WIKI <noreply@wiki.example>".
NAW_MAIL_FROM=

# ---------------------------------------------------------------------------
#  Media and emotes
# ---------------------------------------------------------------------------

# Largest image one upload may be, in bytes. Each image is its own upload and
# never counts toward the article text, which has its own 5 MB limit.
# Default 20 MB.
NAW_UPLOAD_MAX_BYTES=20971520

# Largest avatar, in bytes. Default 2 MB.
NAW_AVATAR_MAX_BYTES=2097152

# How much storage 7TV emotes may take across the install, in bytes. A sync
# stops at this line and says so on the admin page. Default 1 GB.
NAW_EMOTE_BUDGET_BYTES=1073741824

# Outside fetches (emote files, images by link) go direct first and retry
# through this proxy when the direct path fails or stalls: socks5://host:port
# or http://host:port. socks5h:// is refused, since the proxy would then
# resolve names past the engine's private address check. Empty: no fallback.
NAW_FETCH_PROXY=

# ---------------------------------------------------------------------------
#  Localisation
# ---------------------------------------------------------------------------

# Language packs: one directory per language, with metadata.toml and one file
# per interface area. Packs load and reload on the fly.
NAW_LOCALES_DIR=locales

# ---------------------------------------------------------------------------
#  Build time, not runtime
# ---------------------------------------------------------------------------

# Builds against the checked-in .sqlx cache instead of a live database. Set it
# for any build on a machine without PostgreSQL, including CI.
# SQLX_OFFLINE=true
