# NotAnotherWiki Engine, environment reference.
#
# Copy to .env and fill in what you need. Every value here is a default or an
# example, never a real credential. .env is gitignored; keep it that way.
#
# Precedence: environment beats config.toml, config.toml beats the built-in
# defaults. A missing config.toml is not an error, the defaults target the
# local docker compose stack.
#
# This file is generated from the code, not from memory. The authorities are
# crates/naw-core/src/config.rs (Config::load and apply_auth_env),
# crates/naw-cli/src/main.rs (seed flags), crates/naw-web/tests, worker/src
# and docker-compose.yml.

# ============================================================================
#  Core: database, cache, listener, paths
# ============================================================================

# Postgres. NAW_DATABASE_URL wins; DATABASE_URL is accepted as a fallback so
# sqlx tooling and the server can share one variable.
NAW_DATABASE_URL=postgres://naw:naw@127.0.0.1:5433/naw_dev
# DATABASE_URL=postgres://naw:naw@127.0.0.1:5433/naw_dev

# Valkey, speaking the Redis protocol. NAW_VALKEY_URL wins, VALKEY_URL is the
# fallback.
NAW_VALKEY_URL=redis://127.0.0.1:6380
# VALKEY_URL=redis://127.0.0.1:6380

NAW_HTTP_BIND=127.0.0.1
NAW_HTTP_PORT=4242

# Uploaded media root.
NAW_STORAGE_ROOT=./uploads
# Active skin. skins/default, skins/snackers, skins/filian.
NAW_SKIN_DIR=skins/default
# Where `naw seed` looks for flavor definitions.
NAW_SEED_DIR=seeds

# ============================================================================
#  Auth: sessions, providers, linking
# ============================================================================

# Master switch. When false, every auth route answers 404 and nothing else
# about the wiki changes. Reading stays anonymous either way.
NAW_AUTH_ENABLED=false

# Absolute public base URL. Used to build provider callback URLs and email
# links, and it is what decides whether the session cookie gets `Secure`.
# Register exactly {base}/auth/{provider}/callback in each provider console.
# Never derived from the request Host header, on purpose.
NAW_AUTH_BASE_URL=http://127.0.0.1:4242

# Session lifetime in hours. 720 = 30 days.
NAW_AUTH_SESSION_TTL_HOURS=720

# Attach a new provider identity to an existing account when the provider
# certifies the email AND that account already confirmed the same address.
# Both sides must be verified, otherwise this would be an account takeover.
NAW_AUTH_AUTO_LINK_VERIFIED_EMAIL=true

# Loopback-only instant sign-in as a fixed `dev` user, for end-to-end runs
# without any real secrets. Refuses off loopback and refuses when the base URL
# is https. Never enable in production.
#
# WARNING: behind a reverse proxy every request arrives from 127.0.0.1, so the
# loopback check alone is not protection. Keep this false in production.
NAW_AUTH_DEV_LOGIN=false

# Serves /dev/mailbox from the log mail backend. Loopback only.
NAW_DEV_MAILBOX=false

# Comma separated. Names only an admin may grant. Overrides the built-in list
# (vai, snacker, filian, admin, moderator, wiki, support) when set.
# NAW_AUTH_RESERVED_USERNAMES=vai,snacker,filian,admin,moderator,wiki,support

# ---------------------------------------------------------------------------
#  Provider credentials. A provider is enabled exactly when BOTH its id and
#  secret are present and non-empty. There is no separate per-provider switch.
#  Blank or missing means that provider answers 404 rather than starting a
#  flow it cannot finish.
# ---------------------------------------------------------------------------

# Implemented today: GitHub, Discord, Telegram.

# github.com/settings/developers -> New OAuth App. Scopes read:user
# user:email, requested automatically.
NAW_GITHUB_CLIENT_ID=
NAW_GITHUB_CLIENT_SECRET=

# discord.com/developers/applications -> OAuth2. Scopes openid identify email.
NAW_DISCORD_CLIENT_ID=
NAW_DISCORD_CLIENT_SECRET=

# @BotFather -> your bot -> Login Widget. The Client ID is the bot id and it
# doubles as the id_token `aud` claim. Register the callback in Allowed URLs.
# Telegram provides no email at all, only a phone number, which this engine
# does not request.
NAW_TELEGRAM_CLIENT_ID=
NAW_TELEGRAM_CLIENT_SECRET=

# Accepted by config but no backend yet: setting these does nothing until the
# provider is implemented, and the route stays 404 meanwhile.
NAW_GOOGLE_CLIENT_ID=
NAW_GOOGLE_CLIENT_SECRET=
NAW_YANDEX_CLIENT_ID=
NAW_YANDEX_CLIENT_SECRET=
NAW_TWITCH_CLIENT_ID=
NAW_TWITCH_CLIENT_SECRET=
# Steam uses OpenID 2.0, not OAuth2. The key is only for the profile lookup;
# login itself works without it.
NAW_STEAM_API_KEY=

# ============================================================================
#  Mail
# ============================================================================

# log  = store the letter in mail_outbox and show it at /dev/mailbox, no
#        infrastructure needed. This is the dev default.
# smtp = real delivery. The transport is not wired yet, so selecting smtp
#        currently fails loudly rather than dropping mail silently.
NAW_MAIL_BACKEND=log

# smtp://host:port or smtps://user:pass@host:port. Redacted from Debug output.
NAW_SMTP_URL=
# Envelope from, e.g. "FilianWIKI <noreply@snackers.wiki>".
NAW_MAIL_FROM=

# ============================================================================
#  Seeding (crates/naw-cli, `naw seed`)
#
#  Every one of these is a fallback for the matching command line flag, so the
#  flag wins when both are present. Only the slug is required.
# ============================================================================

# NAW_SEED_SLUG=snackers
# NAW_SEED_FLAVOR=filian
# NAW_SEED_NAME=FilianWIKI
# NAW_SEED_DOMAIN=snackers.wiki
# NAW_SEED_LOCALE=en
# NAW_SEED_VTUBER=Filian
# NAW_SEED_COMMUNITY=Snackers
# Comma separated extra hostnames.
# NAW_SEED_ALIASES=www.snackers.wiki,snackers.vai-rice.space

# ============================================================================
#  Tests
# ============================================================================

# The WeCantGive500 live suite is opt-in and needs a server already running.
# Without this set to 1 it skips instead of failing.
# NAW_RUN_LIVE_TESTS=1
# Must be http:// so the suite cannot be pointed at production by accident.
# NAW_TEST_BASE_URL=http://127.0.0.1:4242
# Makes missing favicon and manifest assets a failure instead of a skip.
# NAW_TEST_REQUIRE_BRAND_ASSETS=1

# ============================================================================
#  Worker (worker/, Bun >= 1.4.2)
#
#  Optional and never on the request path. Reading works without it; the
#  content is stale but correct.
# ============================================================================

WORKER_PORT=8081

# ============================================================================
#  docker compose only (docker-compose.yml)
# ============================================================================

POSTGRES_USER=naw
POSTGRES_PASSWORD=naw
POSTGRES_DB=naw_dev
MEILI_ENV=development
MEILI_MASTER_KEY=

# ============================================================================
#  Build time, not runtime
# ============================================================================

# Builds against the checked-in .sqlx cache instead of a live database. Set it
# for any build on a machine without Postgres, including CI.
# SQLX_OFFLINE=true

# ============================================================================
#  Operator tooling. NOT read by the server.
#
#  These live in .env for convenience and are consumed by deploy scripts and
#  maintenance tasks. Listed so nobody wonders what an undocumented variable
#  in a real .env is doing there.
# ============================================================================

# Cloudflare, for DNS work on snackers.wiki and filian.wiki. The token needs
# Zone:DNS:Edit. Reminder: the CF proxy must stay OFF on every record, because
# RKN blocks the proxy ranges and an orange cloud cuts off Russian readers.
CF_ID=
CF_TOKEN=

# Telegram bot token from @BotFather, for the notification bot and for
# uploading emoji packs. This is NOT the same thing as
# NAW_TELEGRAM_CLIENT_SECRET, which is the OIDC login secret.
NAW_TELEGRAM_BOT_TOKEN=

# sudo password for VAIDSERVER, used by the NixOS deploy steps.
DEPLOY_SUDO_PASS=
