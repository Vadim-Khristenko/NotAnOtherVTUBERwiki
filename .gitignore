/static/uploads/


# ─────────────────────────────────────────────────────────────────────────────
#  MISC
# ─────────────────────────────────────────────────────────────────────────────

# Sentry CLI
.sentryclirc

# Terraform (if infra-as-code added later)
*.tfstate
*.tfstate.*
.terraform/

# GitHub Codespaces / Devcontainer state
.devcontainer/*
!.devcontainer/devcontainer.json

# Compiled skins cache (generated at runtime, not committed)
/cache/
/.skin-cache/

# Local things
PLAN.md
.local/


# ─────────────────────────────────────────────────────────────────────────────
#  DOT-DIRECTORIES: ignore all, keep only what the project needs
# ─────────────────────────────────────────────────────────────────────────────
# Tools (agents, editors, CI runners) keep dropping hidden utility folders.
# Ignore every dot-directory by default; each exception below is deliberate
# and must stay below this rule (last matching pattern wins).
.*/

# CI and forge hosting configs (tracked, required for automation)
!.github/
!.forgejo/
!.gitlab/

# SQLx offline query cache (tracked, CI builds with SQLX_OFFLINE=true)
!.sqlx/

# Editor dirs whose files are allow-listed above (dir itself must be
# re-included, otherwise file-level ! rules stop working)
!.vscode/
!.devcontainer/
