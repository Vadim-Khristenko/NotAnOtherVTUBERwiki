# ============================================================================
#  NotAnOtherVTUBERwiki Wiki Engine — .gitignore
#  Covers: Rust, WASM, Leptos, TailwindCSS, Node tooling, Docker volumes,
#          PostgreSQL, Redis, Meilisearch, MinIO, frp, IDE, OS artifacts.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  RUST / CARGO
# ─────────────────────────────────────────────────────────────────────────────
/target/
**/target/
.dev/
**/*.rs.bk
*.pdb
*.d
*.rlib
*.rmeta
*.so
*.dylib
*.dll

# Cargo lock — INCLUDE for binaries (this is a binary project)
# Cargo.lock is tracked, do NOT ignore it.

# cargo-expand output
*.expanded.rs

# cargo-fuzz
/fuzz/artifacts/
/fuzz/corpus/

# cargo-flamegraph / perf
flamegraph.svg
perf.data
perf.data.old


# ─────────────────────────────────────────────────────────────────────────────
#  WASM / LEPTOS (NotAnOtherVTUBERwiki-editor)
# ─────────────────────────────────────────────────────────────────────────────
/dist/
**/pkg/
**/*.wasm.d.ts
**/wasm-bindgen-test/
/crates/NotAnOtherVTUBERwiki-editor/dist/
/crates/NotAnOtherVTUBERwiki-editor/pkg/
/crates/NotAnOtherVTUBERwiki-editor/target/

# trunk build output
/.trunk/

# wasm-pack
**/wasm-pack.log

# wasm-opt intermediate
*.wasm.map
*.wasm.bak


# ─────────────────────────────────────────────────────────────────────────────
#  NODE / NPM / PNPM (TailwindCSS, esbuild, LightningCSS tooling)
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock
.pnp.*
.yarn/

# Vite and worker build output
ui/dist/
worker/dist/

# npm debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


# ─────────────────────────────────────────────────────────────────────────────
#  TAILWINDCSS / ASSET PIPELINE
# ─────────────────────────────────────────────────────────────────────────────

# Generated CSS output (built from source, never committed)
/static/css/output.css
/static/css/*.min.css
/assets/dist/
/static/dist/

# Cache-busted hashed assets (generated by esbuild/LightningCSS)
/static/assets/*.[0-9a-f]*.css
/static/assets/*.[0-9a-f]*.js
/assets/manifest.json


# ─────────────────────────────────────────────────────────────────────────────
#  ENVIRONMENT / SECRETS / CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# Main config with secrets (template is tracked, actual is not)
config.toml
!config.example.toml

# Secret keys, certs, tokens
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
secrets/
/tls/


# ─────────────────────────────────────────────────────────────────────────────
#  DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# Local PG data directory (Docker volume or manual)
/pgdata/
/postgres-data/
/data/postgres/

# SQLx offline query cache — INCLUDE in repo for CI compile-checks
# sqlx-data.json / .sqlx/ is tracked, do NOT ignore.

# Database dumps
*.sql.gz
*.sql.bak
*.dump
*.pgdump
/backups/
/db-backups/


# ─────────────────────────────────────────────────────────────────────────────
#  REDIS
# ─────────────────────────────────────────────────────────────────────────────
/redis-data/
/data/redis/
dump.rdb
appendonly.aof
*.rdb


# ─────────────────────────────────────────────────────────────────────────────
#  MEILISEARCH
# ─────────────────────────────────────────────────────────────────────────────
/meili-data/
/data/meilisearch/
/meili_data/
data.ms/


# ─────────────────────────────────────────────────────────────────────────────
#  MINIO / S3 LOCAL STORAGE
# ─────────────────────────────────────────────────────────────────────────────
/minio-data/
/data/minio/
/s3-data/


# ─────────────────────────────────────────────────────────────────────────────
#  FRP (tunnel — config contains server tokens)
# ─────────────────────────────────────────────────────────────────────────────
frpc.toml
frpc.ini
frps.toml
frps.ini
!frpc.example.toml
!frps.example.toml


