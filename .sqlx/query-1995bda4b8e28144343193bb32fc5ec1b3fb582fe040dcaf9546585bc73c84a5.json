{
  "db_name": "PostgreSQL",
  "query": "SELECT p.slug, p.title, COALESCE(p.locale, '') AS \"locale!\", r.created_at\n           FROM revisions r JOIN pages p ON p.id = r.page_id\n           WHERE r.author_id = $1 AND p.wiki_id = $2 AND p.namespace = 'main'\n           ORDER BY r.created_at DESC LIMIT $3",
