  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.expires_at, u.id AS user_id, u.username,\n               u.email AS email_opt,\n               (u.email_verified_at IS NOT NULL) AS email_verified,\n               u.global_role, u.locale, u.must_change_password\n        FROM sessions s\n        JOIN users u ON u.id = s.user_id\n        WHERE s.id = $1\n        ",
