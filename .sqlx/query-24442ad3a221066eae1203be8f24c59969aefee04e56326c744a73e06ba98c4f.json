  "query": "SELECT category, min(name) AS \"name!\", count(*) AS \"pages!\"\n               FROM page_categories\n               WHERE wiki_id = $1 AND (category ILIKE $2 OR name ILIKE $3)\n               GROUP BY category ORDER BY count(*) DESC, category\n               LIMIT $4",
