{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.slug, COALESCE(p.locale, '') AS \"locale!\"\n           FROM pages p JOIN revisions r ON r.id = p.current_revision_id\n           WHERE p.wiki_id = $1 AND p.namespace = 'main' AND p.deleted_at IS NULL\n             AND r.author_id = $2",
