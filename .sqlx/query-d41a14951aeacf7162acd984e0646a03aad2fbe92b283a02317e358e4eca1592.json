  "query": "SELECT p.title, p.slug, p.namespace::text AS \"namespace!\"\n           FROM template_uses u JOIN pages p ON p.id = u.page_id\n           WHERE u.wiki_id = $1 AND u.template_slug = $2 AND p.deleted_at IS NULL\n           ORDER BY p.title LIMIT $3",
