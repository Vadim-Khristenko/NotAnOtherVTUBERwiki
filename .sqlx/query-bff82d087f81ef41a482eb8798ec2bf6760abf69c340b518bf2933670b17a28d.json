  "query": "\n        SELECT r.id, r.body_md, r.summary, r.is_minor, r.created_at, u.username AS \"author?\"\n        FROM revisions r\n        LEFT JOIN users u ON u.id = r.author_id\n        WHERE r.id = $1 AND r.page_id = $2\n        ",
