  "query": "SELECT p.locale, p.title FROM pages p\n           WHERE p.wiki_id = $1 AND p.namespace::text = $2 AND p.slug = $3\n             AND COALESCE(p.locale, '') <> COALESCE($4, '')\n             AND p.deleted_at IS NULL AND p.current_revision_id IS NOT NULL\n           ORDER BY p.locale",
