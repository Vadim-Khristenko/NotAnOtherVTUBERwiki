  "query": "SELECT p.id, p.is_locked, r.id AS revision_id, r.body_md\n           FROM pages p JOIN revisions r ON r.id = p.current_revision_id\n           WHERE p.wiki_id = $1 AND p.namespace = 'user' AND p.slug = $2\n             AND p.deleted_at IS NULL",
