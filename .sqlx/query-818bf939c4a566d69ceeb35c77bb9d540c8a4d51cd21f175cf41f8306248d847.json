{
  "db_name": "PostgreSQL",
  "query": "SELECT m.name, m.kind, m.storage_key, m.filename, m.created_at\n           FROM media m\n           WHERE m.wiki_id = $1 AND m.hidden_at IS NULL\n             AND (m.name ILIKE '%' || $2 || '%' OR m.filename ILIKE '%' || $2 || '%')\n           ORDER BY (m.name ILIKE $2 || '%') DESC, m.created_at DESC\n           LIMIT $3 OFFSET $4",
