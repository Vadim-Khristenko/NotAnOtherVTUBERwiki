{
  "db_name": "PostgreSQL",
  "query": "SELECT p.slug, p.title, p.locale, p.updated_at, p.current_revision_id AS \"revision!\"\n           FROM pages p\n           WHERE p.wiki_id = $1 AND p.namespace::text = $2\n             AND COALESCE(p.locale, '') = COALESCE($3, '')\n             AND p.deleted_at IS NULL AND p.current_revision_id IS NOT NULL\n             AND p.slug > $4\n           ORDER BY p.slug\n           LIMIT $5",
