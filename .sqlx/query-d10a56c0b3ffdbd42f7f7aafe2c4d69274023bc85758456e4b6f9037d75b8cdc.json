  "query": "\n        SELECT a.action, a.created_at, a.meta, u.username AS \"actor?\"\n        FROM audit_log a\n        LEFT JOIN users u ON u.id = a.user_id\n        WHERE a.wiki_id = $1\n        ORDER BY a.created_at DESC\n        LIMIT 10\n        ",
