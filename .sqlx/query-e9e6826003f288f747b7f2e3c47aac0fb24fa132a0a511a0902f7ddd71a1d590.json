  "db_name": "PostgreSQL",
  "query": "SELECT b.id, b.network::text AS \"network!\", b.reason, b.created_at, b.expires_at,\n                  u.username AS \"by?\"\n           FROM ip_blocks b LEFT JOIN users u ON u.id = b.created_by\n           WHERE b.wiki_id = $1\n           ORDER BY (b.expires_at IS NOT NULL AND b.expires_at <= now()), b.created_at DESC",
